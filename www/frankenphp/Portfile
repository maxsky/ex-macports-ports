# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

name                frankenphp
version             1.12.1
categories          www php
platforms           darwin
maintainers         nomaintainer
license             MIT

description         FrankenPHP is a modern PHP app server.
long_description    FrankenPHP is a modern application server \
                    for PHP built on top of the Caddy web server.

homepage            https://frankenphp.dev

github.setup        dunglas frankenphp ${version} v
github.tarball_from releases

use_configure       no
build               {}

if {[exec uname -m] eq "arm64"} {
    distfiles       ${github.project}-mac-arm64

    checksums       sha256 d26935d6ec0db54400aa9086a2619a8e3e74a6ec383728bbae69894415842a35
} else {
    distfiles       ${github.project}-mac-x86_64

    checksums       sha256 99d958b3112f14c93957239157981adc234853b49f613bf39023be01333f3c49
}

destroot {
    set bindir ${destroot}${prefix}/bin
    xinstall -d ${bindir}
    xinstall -m 755 ${distpath}/${distfiles} ${bindir}/${name}
}
